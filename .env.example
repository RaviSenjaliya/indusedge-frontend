# Copy to .env.local for local development.
# On Render these are set in Dashboard -> Static Site -> Environment.
# Only VITE_-prefixed variables reach the browser bundle, and they are PUBLIC.
# Never put API keys or passwords here.

# Absolute API base URL, including the /api suffix.
# Leave this UNSET locally so requests go through the Vite dev proxy.
VITE_API_BASE_URL=https://indusedge-backend.onrender.com/api

# Dev-only: where the Vite proxy forwards /api. Not shipped to the browser.
DEV_API_PROXY=http://localhost:5002
